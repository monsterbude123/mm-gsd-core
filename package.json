    "@vitejs/plugin-react": "6.3.0",
    "lucide-react": "1.76.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "2.3.4"
  },
